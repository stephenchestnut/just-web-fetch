{
  "name": "just-web-fetch",
  "version": "2.0.0",
  "description": "Pi extension: fetch web pages via headless Chrome and extract readable Markdown with trafilatura, without LLM summarization",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "web-fetch",
    "puppeteer",
    "trafilatura"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stephenchestnut/just-web-fetch.git"
  },
  "author": "stephenchestnut",
  "license": "MIT",
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "picomatch": "^4.0.3",
    "puppeteer": "^24.0.0"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.2",
    "vitest": "^4.0.18"
  },
  "homepage": "https://github.com/stephenchestnut/just-web-fetch#readme",
  "bugs": {
    "url": "https://github.com/stephenchestnut/just-web-fetch/issues"
  },
  "contributors": [
    "georgebashi (original pi-web-fetch author)"
  ]
}
